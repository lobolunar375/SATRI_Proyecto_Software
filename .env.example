# SATRI - Variables de entorno
# Copia este archivo a .env y completa los valores

# VirusTotal API Key (https://virustotal.com)
VIRUSTOTAL_API_KEY=tu_api_key_aqui

# MongoDB
MONGO_ROOT_USERNAME=satri
MONGO_ROOT_PASSWORD=tu_password_aqui

# Grafana
GF_SECURITY_ADMIN_PASSWORD=tu_password_aqui

# OpenSearch
OPENSEARCH_ADMIN_PASSWORD=tu_password_aqui

# JIRA - Integracion de Ticketing
JIRA_SERVER=https://tu-equipo.atlassian.net
